# Dashboard auth
ADMIN_PASSWORD=replace-with-a-long-password
SESSION_SECRET=replace-with-at-least-32-random-bytes

# Supabase server-side REST access
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Recommended modern server key from Supabase Settings > API Keys > Secret keys
SUPABASE_SECRET_KEY=sb_secret_replace_me
# Legacy fallback (optional instead of SUPABASE_SECRET_KEY)
# SUPABASE_SERVICE_ROLE_KEY=replace-me

# Telegram Bot API
TELEGRAM_BOT_TOKEN=123456:replace-me
TELEGRAM_WEBHOOK_SECRET=replace-with-random-secret

# Secures reader-cli -> Vercel history ingestion
READER_INGEST_SECRET=replace-with-random-secret

# Secures Vercel cron endpoint. Vercel may send this automatically when configured.
CRON_SECRET=replace-with-random-secret

# Conservative safety controls (self-imposed, not Telegram limits)
CLONE_MIN_DESTINATION_DELAY_MS=2000
CLONE_MAX_WRITES_PER_TICK=5
CLONE_MAX_DESTINATIONS_PER_TICK=5
